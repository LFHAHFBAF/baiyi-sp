local function tryFireGManSkill()
    local tSkill = getTSkill()
    if tSkill and gmanFire(tSkill) then
        return true, "T (" .. tSkill .. ")"
    end
    local eSkill = getESkill()
    if eSkill and gmanFire(eSkill) then
        return true, "E (" .. eSkill .. ")"
    end
    local rSkill = getRSkill()
    if rSkill and gmanFire(rSkill) then
        return true, "R (" .. rSkill .. ")"
    end
    return false, nil
end

local function teleportBehindBoss(boss)
    if not boss then return end
    local bossRoot = boss:FindFirstChild("HumanoidRootPart") or boss.PrimaryPart
    if not bossRoot then return end

    local bossPos = bossRoot.Position
    local bossLook = bossRoot.CFrame.LookVector
    local behind = bossPos - bossLook * gmanDistance

    local myHrp = getRootPart()
    if myHrp then
        myHrp.CFrame = CFrame.lookAt(
            behind,
            Vector3.new(bossPos.X, behind.Y, bossPos.Z)
        )
        myHrp.Velocity = Vector3.zero
        myHrp.RotVelocity = Vector3.zero
    end
end

