local function attemptTransform()
    for attempt = 1, MAX_TRANSFORM_ATTEMPTS do
        if not scriptRunning then return false end

        addLog("INFO", string.format("变身尝试 %d/%d", attempt, MAX_TRANSFORM_ATTEMPTS))
        setStatus(string.format("变身尝试 %d/%d...", attempt, MAX_TRANSFORM_ATTEMPTS),
            Color3.fromRGB(255, 200, 100))

        teleportToPosition(GMAN_POSITION, nil)
        task.wait(0.4)

        if gmanFire("ChangeMode") then
            addLog("OK", string.format("已触发 Q 技能（第 %d 次）", attempt))
        else
            addLog("WARN", string.format("Q 技能触发失败（第 %d 次，可能冷却中）", attempt))
        end

        local waitEnd = tick() + 3
        while tick() < waitEnd do
            task.wait(0.25)
            if isGManTurboTransformed() then
                addLog("OK", "变身成功！")
                setStatus("✅ 变身成功", Color3.fromRGB(120, 255, 150))
                return true
            end
        end

        addLog("WARN", string.format("第 %d 次变身未检测到成功", attempt))
    end

    return false
end

