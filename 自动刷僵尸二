                pos1.X, pos1.Y, pos1.Z))
        end

        task.wait(1)
        if not scriptRunning then return end

        local titan2 = workspace:FindFirstChild(SPECIAL_TITAN_NAME)
        if not titan2 then
            addLog("WARN", "SpecialTitan 消失，仍尝试监听 GManTurboScript")
            startGManScriptWatch()
            return
        end

        local pos2 = getObjectPosition(titan2)
        if pos2 then
            addLog("INFO", string.format("SpecialTitan 最新位置：%.1f, %.1f, %.1f",
                pos2.X, pos2.Y, pos2.Z))
        end

        local prompt, promptPart = findPromptForTitan(titan2)
        if not prompt then
            addLog("ERROR", "未找到 SpecialTitan 的 ProximityPrompt",
                "PROMPT_NOT_FOUND")
            startGManScriptWatch()
            return
        end

        addLog("INFO", string.format("找到 ProximityPrompt，距离 titan 约 %.1f studs",
            (promptPart.Position - pos2).Magnitude))

        local targetPos = promptPart.Position + Vector3.new(0, 3, 0)
        local ok, err = teleportToPosition(targetPos, nil)
        if not ok then
            addLog("ERROR", "传送到互动点失败：" .. tostring(err), "TELEPORT_FAILED")
            startGManScriptWatch()
            return
        end
        addLog("OK", "已传送到互动点附近")

        task.wait(0.8)
        if not scriptRunning then return end

        if fireproximityprompt then
            local fired = pcall(fireproximityprompt, prompt)
            if fired then
                addLog("OK", "已触发 ProximityPrompt 互动")
            else
                addLog("WARN", "fireproximityprompt 调用失败")
            end
        else
            addLog("WARN", "无 fireproximityprompt，靠位置自动触发")
        end

        setStatus("互动已尝试，持续监听 GManTurboScript...",
            Color3.fromRGB(120, 255, 150))

        task.wait(0.5)
        startGManScriptWatch()
    end)
end

