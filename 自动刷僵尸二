local function waitForRespawnAndScript()
    if not scriptRunning then return false end
    local oldChar = player.Character
    local t1 = tick() + 30
    while player.Character == oldChar and tick() < t1 and scriptRunning do
        task.wait(0.1)
    end
    if not scriptRunning then return false end

    if not player.Character or player.Character == oldChar then
        local ok = pcall(function() player.CharacterAdded:Wait() end)
        if not ok then
            addLog("ERROR", "等待新角色超时", "RESPAWN_TIMEOUT")
            return false
        end
    end

    local t2 = tick() + 20
    while tick() < t2 and scriptRunning do
        local c = player.Character
        if c and c:FindFirstChild("CooldownFolder") and c:FindFirstChild("ValuesFolder") then
            break
        end
        task.wait(0.1)
    end

    local living = workspace:FindFirstChild("Living")
    if living and scriptRunning then
        local folder = living:FindFirstChild(player.Name)
        if not folder then
            folder = living:WaitForChild(player.Name, 30)
        end
        if folder and not folder:FindFirstChild("HeadCaptainOfCCTVScript") then
            folder:WaitForChild("HeadCaptainOfCCTVScript", 30)
        end
    end

    task.wait(0.5)
    return scriptRunning
end

local function safeResetAndRespawn()
    if gmanPhaseActive then
        addLog("WARN", "GManTurbo 阶段禁止 reset，已阻止", "RESET_BLOCKED_GMAN")
        return false
    end
    if resetInProgress then return false end
    resetInProgress = true
    doReset()
    local ok = waitForRespawnAndScript()
    resetInProgress = false
    return ok
end

local function getObjectPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Attachment") then return obj.WorldPosition end
    if obj:IsA("Model") then
        local hrp = obj:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position end
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local ok, cf = pcall(function() return obj:GetBoundingBox() end)
        if ok and cf then return cf.Position end
        local ok2, pivot = pcall(function() return obj:GetPivot() end)
        if ok2 and pivot then return pivot.Position end
    end
    return nil
end

local function findPromptForTitan(titan)
    if not titan then return nil, nil end
    for _, d in ipairs(titan:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local part = d.Parent
            if part and part:IsA("BasePart") then
                return d, part
            end
        end
    end

    local titanPos = getObjectPosition(titan)
    if not titanPos then return nil, nil end

    local nearest, nearestPart, minDist = nil, nil, 500
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local part = p.Parent
            if part and part:IsA("BasePart") then
                local dist = (part.Position - titanPos).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = p
                    nearestPart = part
                end
            end
        end
    end
    return nearest, nearestPart
end

