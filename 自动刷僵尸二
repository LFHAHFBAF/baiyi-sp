function startGManBattle()
    if gmanBattleActive then return end
    gmanBattleActive = true

    addLog("INFO", "GManTurbo 战斗循环启动")
    setStatus("等待 Z UTTV...", Color3.fromRGB(255, 220, 120))

    displayBossName = BOSS3_NAME

    task.spawn(function()
        local currentBossName = BOSS3_NAME
        local skillGraceUntil = 0
        local boss5LastB = 0

        while gmanBattleActive and scriptRunning do
            local myHum = getMyHumanoid()
            if not myHum then
                setStatus("⚠️ 角色丢失，等待恢复...", Color3.fromRGB(255, 150, 150))
                task.wait(0.3)
                continue
            end

            if myHum.Health <= 0 then
                addLog("ERROR", "GManTurbo 阶段角色死亡", "GMAN_DIED")
                setStatus("❌ GManTurbo 死亡，任务失败", Color3.fromRGB(255, 80, 80))
                endScript("GManTurbo 死亡，脚本停止")
                return
            end

            if boss5PhaseActive then
                local living = workspace:FindFirstChild("Living")
                if not living then
                    task.wait(0.5)
                    continue
                end

                local boss5 = living:FindFirstChild(BOSS5_NAME)
                local boss5Hum = boss5 and boss5:FindFirstChildOfClass("Humanoid")

                if boss5 or boss5Hum then
                    if not boss5SeenOnce then
                        boss5SeenOnce = true
                        addLog("OK", "Boss5 本体已出现，开始攻击")
                    end
                end

                local boss5ModelGone = (boss5SeenOnce and not boss5)
                local boss5HealthZero = (boss5 and boss5Hum and boss5Hum.Health <= 0)

                if boss5ModelGone or boss5HealthZero then
                    if boss5ModelGone then
                        addLog("OK", BOSS5_NAME .. " 模型已消失，判定为已死亡")
                    else
                        addLog("OK", BOSS5_NAME .. " 血量已归零，判定为已死亡")
                    end
                    setStatus("🎉 Z UTTV Tentacle 已击败，脚本结束",
                        Color3.fromRGB(120, 255, 150))
                    endScript(BOSS5_NAME .. " 已被击败，全部任务完成，脚本停止运行")
                    return
                end

                if BOSS5_SKILL_REQUIRE_BOSS then
                    if not boss5 or not boss5Hum then
                        setStatus("⏳ Boss5：等待 Z UTTV Tentacle 本体出现（配置要求）...",
                            Color3.fromRGB(255, 220, 120))
                        task.wait(0.3)
                        continue
                    end
                end

                local lmbOK = gmanLMB()

                local now = tick()

                local elapsed
                if boss5LastB == 0 then
                    elapsed = BOSS5_SKILL_INTERVAL
                else
                    elapsed = now - boss5LastB
                end

                if elapsed >= BOSS5_SKILL_INTERVAL then
                    if gmanFire("IAmAtomic") then
                        addLog("OK", "Boss5 阶段：已触发 B 技能（IAmAtomic）")
                        setStatus(string.format(
                            "⚔️ Boss5：B 技能已触发 · %s",
                            lmbOK and "普攻中" or "普攻待命"),
                            Color3.fromRGB(120, 255, 150))
                    else
                        addLog("WARN", "Boss5 阶段：B 技能触发失败（冷却中？）")
                        setStatus(string.format(
                            "⏳ Boss5：B 技能冷却中 · %s",
                            lmbOK and "普攻中" or "普攻待命"),
                            Color3.fromRGB(255, 220, 120))
                    end
                    boss5LastB = now
                else
                    setStatus(string.format(
                        "🛡️ Boss5：安全区 (Y=1145)，下次 B 技能 %.1fs · %s",
                        BOSS5_SKILL_INTERVAL - elapsed,
                        lmbOK and "普攻中" or "普攻待命"),
                        Color3.fromRGB(180, 255, 180))
                end

                task.wait(0.15)
                continue
            end

            local living = workspace:FindFirstChild("Living")
            if not living then
                task.wait(0.5)
                continue
            end

            if currentBossName == BOSS3_NAME then
                local siren = living:FindFirstChild(BOSS4_NAME)
                local sirenHum = siren and siren:FindFirstChildOfClass("Humanoid")

                if siren and sirenHum and sirenHum.Health > 0 then
                    addLog("OK", "检测到 " .. BOSS4_NAME .. "，切换到安全位置等待 Z UTTV 死亡")
                    setStatus("🛡️ Siren 出现，安全位置等待 Z UTTV 死亡...",
                        Color3.fromRGB(255, 200, 100))
                    teleportToPosition(GMAN_POSITION, nil)

                    local waitStart = tick()
                    local switched = false
                    while gmanBattleActive and scriptRunning do
                        local zuttv = living:FindFirstChild(BOSS3_NAME)
                        local zuttvHum = zuttv and zuttv:FindFirstChildOfClass("Humanoid")

                        if not zuttvHum or zuttvHum.Health <= 0 then
                            addLog("OK", "Z UTTV 已死亡，切换目标为 " .. BOSS4_NAME)
                            setStatus("⚔️ 目标切换为 Siren Titan（追着打）",
                                Color3.fromRGB(120, 255, 150))
                            currentBossName = BOSS4_NAME
                            displayBossName = BOSS4_NAME
                            skillGraceUntil = 0
                            switched = true
                            break
                        end

                        local now = tick()
                        if now - waitStart > 1 then
                            teleportToPosition(GMAN_POSITION, nil)
                            waitStart = now
                        end
                        task.wait(0.3)
                    end

                    if switched then continue end
                end
            end

            local boss = living:FindFirstChild(currentBossName)
            local bossHum = boss and boss:FindFirstChildOfClass("Humanoid")

            if boss and bossHum and bossHum.Health <= 0 then
                if currentBossName == BOSS4_NAME then
                    addLog("OK", BOSS4_NAME .. " 已被击败，进入 Boss5 阶段（Z UTTV Tentacle）")
                    setStatus("✅ Siren 已击败，进入 Boss5 阶段",
                        Color3.fromRGB(120, 255, 150))
                    boss5PhaseActive = true
                    boss5SeenOnce = false
                    displayBossName = BOSS5_NAME
                    boss5LastB = 0
                    skillGraceUntil = 0
                    startBoss5PositionLock()
                    teleportToPosition(BOSS5_SAFE_POSITION, nil)
                    task.wait(0.5)
                    continue
                else
                    addLog("WARN", "Z UTTV 已死亡，等待 Siren 出现...")
                    setStatus("⏳ 等待 Siren 出现...",
                        Color3.fromRGB(255, 220, 120))
                    task.wait(0.5)
                    continue
                end
            end

            if not boss or not bossHum then
                setStatus("⏳ 等待 " .. currentBossName .. " 出现...",
                    Color3.fromRGB(255, 220, 120))
                task.wait(0.3)
                continue
            end

            if currentBossName == BOSS4_NAME then
                teleportBehindBoss(boss)
            end

            local now = tick()
            if now < skillGraceUntil then
                teleportBehindBoss(boss)
                local remain = skillGraceUntil - now
                setStatus(string.format("🎬 技能后摇中 (%.1fs)，跟随 boss...", remain),
                    Color3.fromRGB(255, 220, 100))
                task.wait(0.08)
                continue
            end

            local charge = getCharge()
            local chargeBar = getChargeBar()

            if charge >= 3 then
                teleportBehindBoss(boss)
                local fired, used = tryFireGManSkill()

                if fired then
                    addLog("OK", string.format("释放 %s（Charge=%s）", used, tostring(charge)))
                    setStatus("⚔️ 已释放 " .. used .. "，等待前摇...",
                        Color3.fromRGB(120, 255, 150))
                    skillGraceUntil = tick() + SKILL_GRACE_AFTER_FIRE
                else
                    setStatus("⏳ T/E/R 均冷却中...", Color3.fromRGB(255, 220, 120))
                    task.wait(0.2)
                end
            elseif chargeBar >= 3 then
                if gmanFire("Charge") then
                    addLog("INFO", string.format(
                        "累积 Charge（Charge=%s, ChargeBar=%s）",
                        tostring(charge), safeFormatNumber(chargeBar, "%.2f")))
                    setStatus(string.format(
                        "⚡ 累积 Charge (%s/3)，ChargeBar=%s",
                        tostring(charge), safeFormatNumber(chargeBar, "%.2f")),
                        Color3.fromRGB(180, 255, 180))
                end
                task.wait(CHARGE_SKILL_INTERVAL)
            else
                if currentBossName == BOSS4_NAME then
                    teleportBehindBoss(boss)
                    if gmanLMB() then
                        setStatus("⚔️ Boss4：跟随 Boss，触发 LMB 普通攻击",
                            Color3.fromRGB(120, 255, 150))
                    else
                        setStatus("⚔️ Boss4：跟随 Boss（LMB 冷却中）",
                            Color3.fromRGB(255, 220, 120))
                    end
                    task.wait(0.12)
                else
                    teleportToPosition(GMAN_POSITION, nil)
                    setStatus(string.format(
                        "🛡️ 安全位置等待能量 (ChargeBar=%s)",
                        safeFormatNumber(chargeBar, "%.2f")),
                        Color3.fromRGB(255, 200, 100))
                    task.wait(0.4)
                end
            end
        end
    end)
end

local currentStage    = "boss1"
local hasSeenCurrent  = false
local bossSkillResetAt = 0

local function startBattleLoop()
    if battleActive then return end
    battleActive = true
    currentStage = "boss1"
    hasSeenCurrent = false
    bossSkillResetAt = 0
    displayBossName = BOSS1_NAME

    addLog("INFO", "战斗循环启动（阶段：Boss1）")

    task.spawn(function()
        setStatus("⚔️ 等待 Boss1（波 5）出现...",
            Color3.fromRGB(255, 220, 120))

        while battleActive and scriptRunning do
            local bossName = (currentStage == "boss1") and BOSS1_NAME or BOSS2_NAME
            local bossAlive = isBossAlive(bossName)

            if bossAlive then
                if not hasSeenCurrent then
                    addLog("OK", string.format("%s 已出现",
                        (currentStage == "boss1") and "Boss1" or "Boss2"))
                    setStatus(string.format("⚔️ 正在战斗：%s", bossName),
                        Color3.fromRGB(120, 255, 150))
                end
                hasSeenCurrent = true
            end

            if hasSeenCurrent and not bossAlive then
                if currentStage == "boss1" then
                    addLog("OK", "Boss1 被击败，先 reset 恢复血量")
                    setStatus("✅ Boss1 被击败，重置角色...",
                        Color3.fromRGB(120, 255, 150))

                    if safeResetAndRespawn() then
                        teleportToPosition(CCTV_POSITION, CCTV_LOOK_DIR)
                        addLog("OK", "已传送回 CCTV 位置，等待 Boss2")
                    end

                    currentStage = "boss2"
                    hasSeenCurrent = false
                    bossSkillResetAt = 0
                    displayBossName = BOSS2_NAME
                    setStatus("⚔️ 等待 Boss2（波 10）出现...",
                        Color3.fromRGB(255, 220, 120))
                    addLog("INFO", "切换到阶段：Boss2")
                    continue
                else
                    addLog("OK", "Boss2 被击败，先 reset 恢复血量")
                    setStatus("✅ Boss2 被击败，重置角色...",
                        Color3.fromRGB(120, 255, 150))

                    if safeResetAndRespawn() then
                        teleportToPosition(FINAL_POSITION, nil)
                        addLog("OK", "已传送到最终位置")
                        setStatus("✅ 已传送到最终位置，等待 SpecialTitan",
                            Color3.fromRGB(120, 255, 150))
                    end

                    displayBossName = nil
                    battleActive = false
                    startSpecialTitanWatch()
                    return
                end
            end

            if not hasSeenCurrent then
                setStatus(string.format(
                    "⏳ 等待 %s（%s）出现...",
                    (currentStage == "boss1") and "Boss1" or "Boss2",
                    (currentStage == "boss1") and "波 5" or "波 10"),
                    Color3.fromRGB(255, 220, 120))
                task.wait(0.5)
                continue
            end

            local myHum = getMyHumanoid()
            local myHealth = myHum and myHum.Health or 0

            if myHealth <= 0 then
                setStatus("💀 角色已死亡，等待重生...",
                    Color3.fromRGB(255, 150, 150))
                addLog("WARN", "角色死亡，等待重生")
                waitForRespawnAndScript()
                setStatus("⚔️ 重生完成，继续战斗",
                    Color3.fromRGB(255, 220, 120))
                continue
            end

            if myHealth < 5 then
                setStatus(string.format("⚠️ 血量低 (%.1f)，5 秒后重置...", myHealth),
                    Color3.fromRGB(255, 200, 100))
                addLog("WARN", string.format("血量低 (%.1f)，5 秒后重置", myHealth))
                task.wait(LOW_HEALTH_RESET_DELAY)

                if not scriptRunning then return end
                myHum = getMyHumanoid()
                myHealth = myHum and myHum.Health or 0

                if myHealth > 0 and myHealth < 5 then
                    setStatus("🔄 执行 reset...", Color3.fromRGB(255, 150, 150))
                    addLog("INFO", "执行 reset（血量过低）")
                    if safeResetAndRespawn() then
                        teleportToPosition(CCTV_POSITION, CCTV_LOOK_DIR)
                        setStatus("⚔️ 重生完成，继续战斗",
                            Color3.fromRGB(255, 220, 120))
                    end
                end
                continue
            end

            local center = getBossCenter(bossName)
            if center then
                local hrp = getRootPart()
                if hrp then
                    hrp.CFrame = CFrame.new(center)
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end
            end

            local fired = triggerYSkill()

            if fired then
                bossSkillResetAt = tick()
            end

            if bossSkillResetAt > 0
                and (tick() - bossSkillResetAt) >= SKILL_RESET_DELAY
                and not resetInProgress then

                addLog("INFO", string.format(
                    "技能释放后 %d 秒，触发 reset（阶段：%s）",
                    SKILL_RESET_DELAY,
                    (currentStage == "boss1") and "Boss1" or "Boss2"))
                setStatus("🔄 技能后周期 reset...",
                    Color3.fromRGB(255, 200, 100))
                bossSkillResetAt = 0

                if safeResetAndRespawn() then
                    teleportToPosition(CCTV_POSITION, CCTV_LOOK_DIR)
                    setStatus("⚔️ 重生完成，继续战斗",
                        Color3.fromRGB(255, 220, 120))
                end
                continue
            end

            task.wait(0.1)
        end
    end)
end

local function checkMode()
    if not ModeValue then return false, "Mode 尚未加载", "MODE_NOT_LOADED" end
    local strVal = tostring(ModeValue.Value)
    if strVal ~= REQUIRED_MODE then
        return false, string.format("模式不匹配 (当前: %s)", strVal), "MODE_MISMATCH"
    end
    return true
end

