local function safeValue(v)
    if type(v) ~= "number" then return 0 end
    if v ~= v then return 0 end
    if v == math.huge then return 999999 end
    if v == -math.huge then return -999999 end
    return v
end

local function safeFormatNumber(n, fmt)
    if type(n) ~= "number" then return "?" end
    if n ~= n then return "NaN" end
    if n == math.huge then return "INF" end
    if n == -math.huge then return "-INF" end
    return string.format(fmt, n)
end

local function teleportToPosition(position, lookDir)
    local char = player.Character
    if not char then return false, "角色未加载" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "未找到 HumanoidRootPart" end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        humanoid.Sit = false
        task.wait(0.1)
    end

    if lookDir then
        local flat = Vector3.new(lookDir.X, 0, lookDir.Z)
        if flat.Magnitude > 0 then
            flat = flat.Unit
            hrp.CFrame = CFrame.lookAt(position, position + flat)
        else
            hrp.CFrame = CFrame.new(position)
        end
    else
        hrp.CFrame = CFrame.new(position)
    end

    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
    return true
end

