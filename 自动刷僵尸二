            setStatus("⚠️ CCTV 传送失败: " .. tostring(err2),
                Color3.fromRGB(255, 150, 150))
            addLog("ERROR", "CCTV 传送失败：" .. tostring(err2), "TELEPORT_FAILED")
        end
    end)
end

local function startCCTVWatch()
    if cctvWatchActive then return end
    cctvWatchActive = true
    cctvTriggered = false

    setStatus("监听 CCTV 脚本中...", Color3.fromRGB(180, 220, 255))
    addLog("INFO", "开始监听 HeadCaptainOfCCTVScript")

    task.spawn(function()
        if not scriptRunning then return end
        local living = workspace:WaitForChild("Living", 30)
        if not living or not scriptRunning then
            if not living then
                addLog("ERROR", "未找到 Workspace.Living", "LIVING_NOT_FOUND")
                scriptRunning = false
                updateButtonState("idle")
            end
            cctvWatchActive = false
            return
        end

        local folder = living:FindFirstChild(player.Name)
        if not folder then folder = living:WaitForChild(player.Name, 30) end
        if not folder then
            addLog("ERROR", "未找到玩家文件夹", "PLAYER_FOLDER_NOT_FOUND")
            scriptRunning = false
            updateButtonState("idle")
            cctvWatchActive = false
            return
        end

        if folder:FindFirstChild("HeadCaptainOfCCTVScript") then
            fireCCTVTeleport()
            cctvWatchActive = false
            return
        end

        local done = false
        task.delay(30, function()
            if not done and not cctvTriggered and scriptRunning then
                addLog("ERROR", "HeadCaptainOfCCTVScript 30 秒内未出现",
                    "CCTV_SCRIPT_NOT_FOUND")
            end
        end)

        local conn
        conn = folder.ChildAdded:Connect(function(child)
            if not scriptRunning then
                if conn then conn:Disconnect() end
                return
            end
            if child.Name == "HeadCaptainOfCCTVScript" then
                done = true
                if conn then conn:Disconnect() end
                fireCCTVTeleport()
                cctvWatchActive = false
            end
        end)
    end)
end

local function doStartTask()
    if userClosed then return end
    if screenGui and not screenGui.Parent then return end

    scriptRunning = true
    battleActive = false
    cctvWatchActive = false
    cctvTriggered = false
    resetInProgress = false
    gmanWatchActive = false
    gmanBattleActive = false
    gmanPhaseActive = false
    boss5PhaseActive = false
    boss5SeenOnce = false
    displayBossName = nil

    if specialTitanConn then
        pcall(function() specialTitanConn:Disconnect() end)
        specialTitanConn = nil
    end
    stopBoss5PositionLock()

    updateButtonState("running")

    local n = tonumber(distanceBox.Text)
    if n and n > 0 then gmanDistance = n end

    startSpecialTitanWatch()

    local success, err = teleportToPosition(TARGET_POSITION, nil)
    if success then
        addLog("OK", "已传送到目标位置，开始监听 CCTV")
        startCCTVWatch()
    else
        addLog("ERROR", "传送失败：" .. tostring(err), "TELEPORT_FAILED")
        setStatus("传送失败：" .. tostring(err), Color3.fromRGB(255, 150, 150))
        scriptRunning = false
        updateButtonState("idle")
    end
end

local lastPlayerCount = #Players:GetPlayers()

local function refreshPlayerCountLabel()
    local n = #Players:GetPlayers()
    if n > 1 then
        playerCountLabel.Text = string.format("玩家: %d ⚠️", n)
        playerCountLabel.TextColor3 = Color3.fromRGB(255, 180, 100)
    else
        playerCountLabel.Text = string.format("玩家: %d", n)
        playerCountLabel.TextColor3 = Color3.fromRGB(180, 220, 255)
    end
end

local function onPlayerCountChanged()
    local n = #Players:GetPlayers()
    refreshPlayerCountLabel()
    if n == lastPlayerCount then return end
    if n > 1 and lastPlayerCount <= 1 then
        addLog("WARN", string.format("玩家数：%d（推荐为 1）", n))
    elseif n <= 1 and lastPlayerCount > 1 then
        addLog("OK", string.format("玩家数：%d（推荐状态）", n))
    end
    lastPlayerCount = n
end

Players.PlayerAdded:Connect(function() task.defer(onPlayerCountChanged) end)
Players.PlayerRemoving:Connect(function() task.defer(onPlayerCountChanged) end)

refreshPlayerCountLabel()
if lastPlayerCount > 1 then
    addLog("WARN", string.format("玩家数：%d（推荐为 1）", lastPlayerCount))
end

